class Controller_ingresos  {
    private $Ingresos;

    public function registrarIngreso($Nombre, $Cantidad, $Descripcion, $Observaciones) {
        // Validamos que los campos no estén vacíos
        if (!empty($Nombre) && !empty($Cantidad) && !empty($Descripcion) && !empty($Observaciones)) {
            $resultado = $this->Ingresos->registrar_Ingreso($Nombre, $Cantidad, $Descripcion, $Observaciones);

            if ($resultado) {
                return '<h3 class="ok">Ingreso registrado correctamente</h3>';
            } else {
                return '<h3 class="error">Error al registrar Ingreso</h3>';
            }
        } else {
            return '<h3 class="error">Por favor, complete todos los campos</h3>';
        }
    }
}

